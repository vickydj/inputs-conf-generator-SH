# Objects are private to this app unless exported explicitly below.
[]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

# Admin-only configuration
[views/setup_page_dashboard]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

[ds_info]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

[passwords]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

[inputs]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

# Self-service users
[views/payload_generator]
access = read : [ admin, sc_admin, input_conf_generator_user ], write : [ admin, sc_admin ]

[commands/sendpayload]
access = read : [ admin, sc_admin, input_conf_generator_user ], write : [ admin, sc_admin ]
